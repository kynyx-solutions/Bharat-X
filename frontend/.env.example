# ──────────────────────────────────────────────────────────────
# BharatX Group — Frontend Environment Variables (Vercel)
# ──────────────────────────────────────────────────────────────

# Base URL of the deployed Express backend (Render Web Service).
# Example: https://bharatx-api.onrender.com
# Leave blank for local development to use the Vite /api proxy.
VITE_API_URL=

# Google Analytics 4 measurement ID (optional)
VITE_GA_ID=

# Supabase — admin dashboard (/admin), blog posts, homepage content, enquiries.
# Project Settings → API → Project URL and the "anon public" key. NEVER the service_role key.
# Leave blank and the site runs from its built-in content; /admin shows a setup message.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

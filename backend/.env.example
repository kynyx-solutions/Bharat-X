# ──────────────────────────────────────────────────────────────
# BharatX Group — Backend Environment Variables
# ──────────────────────────────────────────────────────────────

PORT=5000

# MongoDB connection string (Atlas recommended)
MONGO_URI=mongodb+srv

# Comma-separated list of allowed origins for CORS (Vercel domain or localhost)
# Example: https://bharatx-group.vercel.app,http://localhost:5173
CORS_ORIGIN=http://localhost:5174

# Max contact submissions per IP per 15 minutes
RATE_LIMIT_MAX=6

# Email notifications (optional — Nodemailer SMTP)
# Provide your SMTP details to receive emails whenever a user submits the contact form
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_TO=


# Secret for team-only endpoints (GET /api/contact inquiry count). Leave empty to keep them disabled.
ADMIN_TOKEN=
